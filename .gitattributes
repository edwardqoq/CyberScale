# 统一换行：gradlew 若被 Windows 改成 CRLF，Linux/macOS 上会报 "bad interpreter"。
* text=auto

gradlew        text eol=lf
*.sh           text eol=lf
*.kt           text eol=lf
*.kts          text eol=lf
*.md           text eol=lf
*.html         text eol=lf
*.py           text eol=lf
*.xml          text eol=lf
*.properties   text eol=lf

gradlew.bat    text eol=crlf
*.bat          text eol=crlf

# 二进制：禁止换行转换与 diff 破坏
*.png   binary
*.jpg   binary
*.jpeg  binary
*.apk   binary
*.aab   binary
*.jar   binary
*.docx  binary
